# Copy to .env for local use. Never commit real credentials.
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///instance/app.db
HOST=0.0.0.0
PORT=5000
BASE_URL=http://localhost:5000

# SMS: use mock for local testing, or twilio for real delivery
SMS_PROVIDER=mock
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=
